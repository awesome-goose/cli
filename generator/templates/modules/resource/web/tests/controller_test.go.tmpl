func Test{{.ModuleName}}Controller(t *testing.T) {
	test.NewSuiteRunner(t, &{{.ModuleName}}ControllerSuite{}).Run()
}

type {{.ModuleName}}ControllerSuite struct {
	test.Suite
	controller *{{.ModuleNameLower}}.{{.ModuleName}}Controller
	container  *core.Container
}

func (s *{{.ModuleName}}ControllerSuite) SetupTest() {
	s.container = core.NewContainer()
	s.container.Register(func() *{{.ModuleNameLower}}.{{.ModuleName}}Service {
		return &{{.ModuleNameLower}}.{{.ModuleName}}Service{}
	}, "", true)

	s.controller = &{{.ModuleNameLower}}.{{.ModuleName}}Controller{}
	// Fill resolves the service; the log field stays nil (not needed here)
	s.container.Fill(s.controller)
}

func (s *{{.ModuleName}}ControllerSuite) TeardownTest() {
	if s.container != nil {
		s.container.Reset()
	}
}

func (s *{{.ModuleName}}ControllerSuite) TestController_NotNil() {
	s.T.Expect(s.controller).Not().ToBeNil()
}
