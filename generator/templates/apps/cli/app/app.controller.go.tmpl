package app

import (
	"fmt"

	"github.com/awesome-goose/goose/io/output"
	"github.com/awesome-goose/goose/types"
)

type AppController struct {
	appService *AppService `inject:""`
	log        types.Log   `inject:""`
}

func (c *AppController) Health(body *HealthDto) types.Output {
	status := c.appService.Health()
	if body.Type != "" {
		return output.ConsoleSuccess(fmt.Sprintf("%s (flag: %s)", status, body.Type))
	}
	return output.ConsoleSuccess(status)
}

func (c *AppController) Version(body *VersionDto) types.Output {
	return output.Box("{{.AppName}}", []string{
		"Version: 0.0.0",
		"Built with Goose Framework",
	})
}
