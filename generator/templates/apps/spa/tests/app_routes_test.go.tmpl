package tests

import (
	"testing"

	"{{.ModulePath}}/app"
	test "github.com/awesome-goose/goose/testing"
	"github.com/awesome-goose/goose/types"
)

func TestAppRoutes(t *testing.T) {
	test.NewSuiteRunner(t, &AppRoutesSuite{}).Run()
}

type AppRoutesSuite struct {
	test.Suite
	routeTest *test.RouteTest
}

func (s *AppRoutesSuite) SetupTest() {
	routes, err := app.ROUTES.(types.Router).Routes()
	if err != nil {
		s.T.T().Fatal(err)
	}
	s.routeTest = test.NewRouteTest(s.T.T(), routes)
}

func (s *AppRoutesSuite) TestRoutes_NotNil() {
	s.T.Expect(s.routeTest.Routes()).Not().ToBeNil()
}

func (s *AppRoutesSuite) TestRoutes_HasRoutes() {
	routes := s.routeTest.Routes()
	s.T.Expect(len(routes) > 0).ToEqual(true)
}

func (s *AppRoutesSuite) TestRoutes_HealthRouteExists() {
	s.routeTest.TestRouteExists("GET", []string{""})
}

func (s *AppRoutesSuite) TestRoutes_VersionRouteExists() {
	s.routeTest.TestRouteExists("GET", []string{"version"})
}
